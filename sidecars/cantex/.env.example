# Cantex MainNet: https://api.cantex.io
# Cantex TestNet: https://api.testnet.cantex.io
CANTEX_BASE_URL=https://api.cantex.io

# Required: Ed25519 operator key (hex). Set in Cantex admin panel.
CANTEX_OPERATOR_KEY=

# Required for swaps: secp256k1 intent trading key (hex).
CANTEX_TRADING_KEY=

# Where the sidecar listens. Backend talks to this URL.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=6200

# Shared secret the Roil backend sends as X-Sidecar-Auth; reject other callers.
# Pick a long random string. Empty string disables auth (dev only).
SIDECAR_AUTH_TOKEN=

# Where to cache the Cantex API key (challenge-response result).
# Default ./api_key.txt next to the running process.
CANTEX_API_KEY_PATH=./api_key.txt
