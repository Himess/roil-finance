# Validator party that runs the wallet — the party that must accept incoming TIs.
# MainNet:
#   roilfinance-validator-1::12200c84ee23a9dc77edb720e98daae10141862a6ff4bd6a8ed57f86f7a30dcce860
# TestNet:
#   <fill in>
VALIDATOR_PARTY=

# Comma-separated list of party-ids we trust as senders. Empty = accept any.
# Default: just the Cantex provider party so a stranger can't DoS us.
TRUSTED_SENDERS=Cantex-validator-1::122038c015864f106cfed48bb9106b7c89982368d27956ffcdfda6c38328f0909b8c

# How often to poll for new TIs (seconds). Withdrawals are operator-triggered
# and rare, so 60s is plenty; tighten if/when auto-withdraw flows land.
POLL_INTERVAL_SEC=60
