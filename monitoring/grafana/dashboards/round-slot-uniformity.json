        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (slot) (increase(dca_executed_total[$__range]))",
          "format": "time_series",
          "instant": false,
          "legendFormat": "slot {{slot}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DCA executions per round slot ($__range)",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Coefficient of variation (stddev/mean) across slots — a uniform distribution sits below ~0.5. Climbing above 1.0 means executions are clumping into a small set of slots and CIP-0098 cap binding becomes a risk.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 1.2 }
            ]
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
